---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductRail from '../../components/ProductRail.astro';
import Icon from '../../components/Icon.astro';
import { products, photoFor } from '../../lib/catalog.js';
import { SITE } from '../../site.config.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const byAsin = new Map(products.map((p) => [p.asin, p]));
const items = (post.data.asins ?? []).map((a) => byAsin.get(a)).filter(Boolean);

const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Še tri edite za notranje povezovanje (najnovejše razen te).
const others = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => {
    const ph = (p.data.asins ?? []).map((a) => byAsin.get(a)).filter(Boolean).map(photoFor).find((x) => x.kind === 'scene');
    return { p, ph };
  });
---

<Layout title={`${post.data.title} | ${SITE.name}`} description={post.data.description} image={items[0]?.image ?? post.data.cover}>
  <article class="mx-auto max-w-content px-4 pt-8 sm:pt-12">
    <header class="max-w-3xl">
      <nav class="text-sm text-muted" aria-label="Breadcrumb">
        <a href="/blog" class="hover:text-ink">Blog</a> <span class="px-1" aria-hidden="true">/</span>
        <time datetime={post.data.date.toISOString()} class="text-ink">{dateStr}</time>
      </nav>
      <h1 class="mt-3 font-serif text-[2rem] font-semibold leading-[1.15] tracking-[-0.01em] text-ink sm:text-4xl sm:leading-[1.15] lg:text-[2.75rem]">
        {post.data.title}
      </h1>
    </header>

    {items.length > 0 && (
      <section class="mt-6 rounded-xl bg-surface p-4 ring-1 ring-line sm:p-6" aria-labelledby="shop-edit">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="shop-edit" class="text-base font-semibold text-ink">Shop this edit</h2>
          <p class="text-xs text-muted">{SITE.disclosureShort}</p>
        </div>
        <ProductRail items={items} eager label="Shop this edit" />
      </section>
    )}

    <div class="prose prose-slate mt-10 max-w-[65ch] prose-headings:font-serif prose-headings:font-semibold prose-a:text-terracotta prose-strong:text-ink">
      <Content />
    </div>

    {items.length > 0 && (
      <section class="mt-14 max-w-3xl" aria-labelledby="finds">
        <h2 id="finds" class="font-serif text-2xl font-semibold text-ink sm:text-3xl">The finds</h2>
        <p class="mt-1 text-xs text-muted">{SITE.disclosureShort}</p>
        <ul class="mt-6 grid gap-3">
          {items.map((p) => <li><ProductCard product={p} variant="wide" /></li>)}
        </ul>
      </section>
    )}
  </article>

  {others.length > 0 && (
    <section class="mx-auto mt-16 max-w-content px-4" aria-labelledby="more-edits">
      <div class="flex items-end justify-between gap-4 border-t border-line pt-6">
        <h2 id="more-edits" class="font-serif text-2xl font-semibold text-ink">More edits</h2>
        <a href="/blog" class="inline-flex items-center gap-1 text-sm font-semibold text-terracotta hover:text-terracotta-dark">
          All edits <Icon name="arrow-right" />
        </a>
      </div>
      <ul class="mt-6 grid gap-5 sm:grid-cols-3">
        {others.map(({ p, ph }) => (
          <li>
            <a href={`/blog/${p.slug}`} class="group block">
              <img
                src={ph?.src ?? p.data.cover}
                alt=""
                width={ph?.w ?? 1080}
                height={ph?.h ?? 1080}
                loading="lazy"
                class="aspect-[4/3] w-full rounded-xl object-cover"
              />
              <p class="mt-3 text-sm text-muted">{p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })}</p>
              <h3 class="mt-1 line-clamp-3 font-semibold leading-snug text-ink group-hover:underline">{p.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
