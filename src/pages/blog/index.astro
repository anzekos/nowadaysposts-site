---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { products, photoFor } from '../../lib/catalog.js';
import { SITE } from '../../site.config.mjs';

const byAsin = new Map(products.map((p) => [p.asin, p]));
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const ph = (post.data.asins ?? []).map((a) => byAsin.get(a)).filter(Boolean).map(photoFor).find((x) => x.kind === 'scene');
    return { post, ph };
  });
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`Blog | ${SITE.name}`} description="A new home decor edit most days: the pieces trending on Pinterest right now, hand-picked from thousands of Amazon bestsellers.">
  <section class="mx-auto max-w-content px-4 pt-8 sm:pt-12">
    <h1 class="font-serif text-4xl font-semibold text-ink sm:text-5xl">The Blog</h1>
    <p class="mt-2 max-w-2xl text-muted">
      A fresh edit most days: the trending home decor pieces climbing the bestseller charts.
    </p>
    <p class="mt-1 text-xs text-muted">{SITE.disclosureShort}</p>

    <ul class="mt-8 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map(({ post, ph }, i) => (
        <li>
          <a href={`/blog/${post.slug}`} class="group block">
            <img
              src={ph?.src ?? post.data.cover}
              alt=""
              width={ph?.w ?? 1080}
              height={ph?.h ?? 1080}
              loading={i < 3 ? 'eager' : 'lazy'}
              class="aspect-[4/3] w-full rounded-xl bg-surface object-cover"
            />
            <p class="mt-3 text-sm text-muted"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
            <h2 class="mt-1 font-serif text-xl font-semibold leading-snug text-ink group-hover:underline">{post.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta">
              Read the edit <Icon name="arrow-right" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
