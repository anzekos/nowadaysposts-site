---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryChips from '../components/CategoryChips.astro';
import { products, byNewest } from '../lib/catalog.js';
import { SITE } from '../site.config.mjs';

const items = [...products].sort(byNewest);

const title = `Shop All Finds | ${SITE.name}`;
const description = `Every trending home decor find we've curated, ${products.length} pieces handpicked from Amazon bestsellers. Newest first.`;
---

<Layout title={title} description={description} image={items[0]?.image}>
  <section class="mx-auto max-w-content px-4 pb-6 pt-8 sm:pt-12">
    <nav class="mb-3 text-sm text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a> <span class="px-1" aria-hidden="true">/</span>
      <span class="text-ink">Shop</span>
    </nav>
    <h1 class="font-serif text-4xl font-semibold text-ink sm:text-5xl">Shop all finds</h1>
    <p class="mt-2 max-w-2xl text-muted">Every piece we've curated, newest first.</p>
    <p class="mt-1 text-xs text-muted">{SITE.disclosureShort}</p>
    <div class="mt-6">
      <CategoryChips active="all" />
    </div>
  </section>

  <section class="mx-auto max-w-content px-4 pt-4" aria-label="All finds">
    <ProductGrid items={items} initial={24} step={24} />
  </section>
</Layout>
