---
/*
  Prava stran 404.

  Cloudflare Pages brez `404.html` v izhodu servira `index.html` s statusom
  200 na katerikoli neznan naslov. Google to vidi kot neskoncno mnozico
  podvojenih strani (soft 404) in kot obiskovalec ne ves, da si zgresil.
  Astro to datoteko zgradi iz te strani, s cimer je tezava odpravljena.
*/
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site.config.mjs';
import { categories as getCategories } from '../lib/catalog.js';

// nekaj priljubljenih kategorij kot pot naprej, ne slepa ulica
const categories = getCategories().slice(0, 6);
---

<Layout
  title={`Page not found | ${SITE.name}`}
  description="That page has moved or never existed. Here is the way back."
  noindex
>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col justify-center px-4 py-20">
    <p class="text-sm font-semibold text-terracotta">Error 404</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-ink sm:text-5xl">
      This one is out of stock.
    </h1>
    <p class="mt-5 max-w-lg leading-relaxed text-muted">
      The page you were after has moved or never existed. The finds, happily, are all still here.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary px-6">Back to the home page</a>
      <a href="/shop" class="btn-secondary px-6">Browse all finds</a>
    </div>

    {categories.length > 0 && (
      <div class="mt-12 border-t border-line pt-8">
        <p class="text-sm font-semibold text-ink">Popular categories</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {categories.map((c) => (
            <li><a href={`/${c.slug}`} class="chip">{c.name}</a></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>
