---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductRail from '../components/ProductRail.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site.config.mjs';
import { products, byNewest, photoFor, categories as getCategories, seasonalShelf } from '../lib/catalog.js';

const sorted = [...products].sort(byNewest);
// Prvi zaslon: najnovejši izdelki. 8 = 4x2 na telefonu in 2x4 na namizju; 9. se pokaže
// samo pri treh stolpcih (sm), da zadnja vrsta ni prazna.
const fresh = sorted.slice(0, 9);
const freshSet = new Set(fresh.map((p) => p.asin));

// Sezonska polica brez izdelkov, ki so že zgoraj.
const season = seasonalShelf({ exclude: freshSet });
const shelf = season ? season.items : [];

const categories = getCategories();

// Hero mozaik: tri najnovejše scene (iste slike kot na Pinterestu).
const heroScenes = sorted.map((p) => ({ p, ph: photoFor(p) })).filter((x) => x.ph.kind === 'scene').slice(0, 3);

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
const latestScene = latest
  ? (latest.data.asins ?? []).map((a) => products.find((p) => p.asin === a)).filter(Boolean)
      .map(photoFor).find((ph) => ph.kind === 'scene')
  : null;
const fmt = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric' });
---

<Layout image={heroScenes[0]?.p.image}>
  <!-- HERO: kratek, da je prva vrsta izdelkov vidna na telefonu brez dolgega drsenja -->
  <section class="mx-auto grid max-w-content items-center gap-8 px-4 pb-8 pt-8 sm:pt-12 lg:grid-cols-[1.45fr_1fr] lg:gap-12 lg:pb-14 lg:pt-12">
    <div>
      <h1 class="font-serif text-[2.35rem] font-semibold leading-[1.08] tracking-[-0.01em] text-ink sm:text-5xl sm:leading-[1.08] lg:text-[2.75rem]">
        The trending pieces that make a room look designed.
      </h1>
      <p class="mt-4 max-w-md text-base leading-relaxed text-muted sm:text-lg">
        Cozy finds we'd put in our own home, picked fresh every day from thousands of Amazon bestsellers.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-2.5 sm:flex sm:flex-wrap">
        <a href="/shop" class="btn-primary px-4 sm:px-6">
          Shop all {products.length} finds
        </a>
        {latest && (
          <a href={`/blog/${latest.slug}`} class="btn-secondary px-4 sm:px-6">Read today's edit</a>
        )}
      </div>
    </div>

    {heroScenes.length === 3 && (
      <div class="hidden aspect-[6/5] grid-cols-[1.25fr_1fr] grid-rows-2 gap-3 lg:grid" aria-hidden="true">
        {heroScenes.map(({ ph }, i) => (
          <img
            src={ph.src}
            alt=""
            width={ph.w}
            height={ph.h}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class:list={['h-full w-full rounded-xl object-cover', i === 0 && 'row-span-2']}
          />
        ))}
      </div>
    )}
  </section>

  <!-- NOVO TA TEDEN -->
  <section id="trending" class="mx-auto max-w-content scroll-mt-20 px-4 pb-14 sm:pb-20" aria-labelledby="new-title">
    <div class="mb-5 border-t border-line pt-6">
      <h2 id="new-title" class="font-serif text-2xl font-semibold text-ink sm:text-3xl">New this week</h2>
      <p class="mt-1 text-xs text-muted">{SITE.disclosureShort}</p>
    </div>
    <ul class="grid grid-cols-2 gap-x-3 gap-y-7 sm:grid-cols-3 sm:gap-x-5 lg:grid-cols-4">
      {fresh.map((p, i) => (
        <li class:list={[i === 8 && 'hidden sm:block lg:hidden']}>
          <ProductCard product={p} eager={i < 4} />
        </li>
      ))}
    </ul>
    <div class="mt-8 flex justify-center">
      <a href="/shop" class="btn-secondary px-6">
        Shop all {products.length} finds <Icon name="arrow-right" />
      </a>
    </div>
  </section>

  <!-- SEZONSKA POLICA -->
  {season && shelf.length >= 5 && (
    <section class="bg-surface py-14 sm:py-20" aria-labelledby="season-title">
      <div class="mx-auto max-w-content px-4">
        <h2 id="season-title" class="font-serif text-2xl font-semibold text-ink sm:text-3xl">{season.title}</h2>
        <p class="mb-5 mt-1 max-w-xl text-sm text-muted">
          Pinterest plans the season early, so we do too. Our newest seasonal finds in one row.
        </p>
        <ProductRail items={shelf} label={season.title} />
      </div>
    </section>
  )}

  <!-- KATEGORIJE: čipi s sličico, ne devet velikih ploščic -->
  <section id="categories" class="mx-auto max-w-content px-4 py-14 sm:py-20" aria-labelledby="cat-title">
    <h2 id="cat-title" class="font-serif text-2xl font-semibold text-ink sm:text-3xl">Shop by room and piece</h2>
    <ul class="mt-6 grid grid-cols-2 gap-2.5 lg:grid-cols-3">
      {categories.map((c, i) => (
        <li class:list={[i === 0 && categories.length % 2 === 1 && 'col-span-2 lg:col-span-1']}>
          <a href={`/${c.slug}`} class="group flex items-center gap-2.5 rounded-xl bg-surface p-1.5 pr-3 ring-1 ring-line transition-shadow duration-ui ease-out hover:shadow-lift sm:gap-3 sm:p-2 sm:pr-4">
            <img
              src={c.photo.src}
              alt=""
              width={c.photo.w}
              height={c.photo.h}
              loading="lazy"
              class:list={['h-12 w-12 shrink-0 rounded-lg bg-surface sm:h-14 sm:w-14', c.photo.kind === 'scene' ? 'object-cover' : 'object-contain p-1']}
            />
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-ink sm:text-base">{c.name}</span>
              <span class="block text-xs text-muted sm:text-sm">{c.count} {c.count === 1 ? 'find' : 'finds'}</span>
            </span>
            <Icon name="arrow-right" class="hidden h-4 w-4 text-muted transition-transform duration-ui ease-out group-hover:translate-x-0.5 sm:block" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ZADNJI BLOG -->
  {latest && (
    <section class="mx-auto max-w-content px-4" aria-labelledby="edit-title">
      <a href={`/blog/${latest.slug}`} class="group grid overflow-hidden rounded-xl bg-surface ring-1 ring-line transition-shadow duration-ui ease-out hover:shadow-lift md:grid-cols-[1fr_1.15fr]">
        <img
          src={latestScene?.src ?? latest.data.cover}
          alt=""
          width={latestScene?.w ?? 1080}
          height={latestScene?.h ?? 1080}
          loading="lazy"
          class="aspect-[4/3] h-full w-full object-cover md:aspect-auto"
        />
        <div class="flex flex-col justify-center p-6 sm:p-10">
          <p class="text-sm font-medium text-muted">Today's edit, {fmt(latest.data.date)}</p>
          <h2 id="edit-title" class="mt-2 font-serif text-2xl font-semibold leading-snug text-ink group-hover:underline sm:text-3xl">
            {latest.data.title}
          </h2>
          <p class="mt-3 line-clamp-3 leading-relaxed text-muted">{latest.data.description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta">
            Read today's edit <Icon name="arrow-right" />
          </span>
        </div>
      </a>
    </section>
  )}

  <Newsletter />
</Layout>
