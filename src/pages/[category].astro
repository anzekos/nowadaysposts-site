---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryChips from '../components/CategoryChips.astro';
import Newsletter from '../components/Newsletter.astro';
import { products, byNewest } from '../lib/catalog.js';
import { SITE } from '../site.config.mjs';

export function getStaticPaths() {
  const slugs = [...new Set(products.map((p) => p.categorySlug))];
  return slugs.map((slug) => {
    const items = products.filter((p) => p.categorySlug === slug);
    return {
      params: { category: slug },
      props: { items, name: items[0].category },
    };
  });
}

const { items, name } = Astro.props;
const { category } = Astro.params;

// Najnovejši najprej: na vrhu so izdelki z našimi lifestyle scenami in aktualni trendi.
const sorted = [...items].sort(byNewest);

const title = `${name} | ${SITE.name}`;
const description = `Trending ${name.toLowerCase()} we love, handpicked from Amazon bestsellers. ${items.length} ${items.length === 1 ? 'find' : 'finds'}, newest first.`;
---

<Layout title={title} description={description} image={sorted[0]?.image}>
  <section class="mx-auto max-w-content px-4 pb-6 pt-8 sm:pt-12">
    <nav class="mb-3 text-sm text-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink">Home</a> <span class="px-1" aria-hidden="true">/</span>
      <a href="/shop" class="hover:text-ink">Shop</a> <span class="px-1" aria-hidden="true">/</span>
      <span class="text-ink">{name}</span>
    </nav>
    <h1 class="font-serif text-4xl font-semibold text-ink sm:text-5xl">{name}</h1>
    <p class="mt-2 max-w-2xl text-muted">
      Trending {name.toLowerCase()} we love, handpicked from Amazon bestsellers. {items.length} {items.length === 1 ? 'find' : 'finds'}, newest first.
    </p>
    <p class="mt-1 text-xs text-muted">{SITE.disclosureShort}</p>
    <div class="mt-6">
      <CategoryChips active={category} />
    </div>
  </section>

  <section class="mx-auto max-w-content px-4 pt-4" aria-label={name}>
    <ProductGrid items={sorted} initial={24} step={24} />
  </section>

  <Newsletter />
</Layout>
