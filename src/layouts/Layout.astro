---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../site.config.mjs';

/*
  Pisavi sta gostovani pri nas, ne pri Googlu. Prej sta se vlekli z
  fonts.googleapis.com, kar je Googlu poslalo obiskovalcev IP se preden je
  ta karkoli izbral. To je natanko tisto, zaradi cesar so v Nemciji padle
  sodbe proti vgrajenim Google Fonts.
*/
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';

const { title, description, noindex = false, image } = Astro.props;
const pageTitle = title ?? `${SITE.name}: ${SITE.tagline}`;
const pageDesc = description ?? SITE.description ?? SITE.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f6f7" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Pinterest domain verification (claim site) -->
    <meta name="p:domain_verify" content="cf470fb32429a5413a00f3d11dd0d218" />
    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-surface">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
