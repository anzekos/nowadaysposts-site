---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../site.config.mjs';

/*
  Pisavi sta gostovani pri nas, ne pri Googlu. Prej sta se vlekli z
  fonts.googleapis.com, kar je Googlu poslalo obiskovalcev IP se preden je
  ta karkoli izbral. To je natanko tisto, zaradi cesar so v Nemciji padle
  sodbe proti vgrajenim Google Fonts.
*/
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

const { title, description, noindex = false } = Astro.props;
const pageTitle = title ?? `${SITE.name} — ${SITE.tagline}`;
const pageDesc = description ?? SITE.description ?? SITE.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f1e9" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Pinterest domain verification (claim site) -->
    <meta name="p:domain_verify" content="cf470fb32429a5413a00f3d11dd0d218" />
    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen bg-cream font-sans text-ink antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
