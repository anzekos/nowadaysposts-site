---
/**
 * Pasica za privolitev v piškotke (kompaktna od prenove 2026-10-27; prej ~65 % mobilnega zaslona).
 *
 * Pravila, ki jih ne smemo kršiti:
 * 1. "Only necessary" je enako velik, enako obarvan in na isti ravni kot "Accept analytics"
 *    (EDPB Cookie Banner Taskforce: zavrnitev na prvi ravni, brez barvnega namigovanja).
 * 2. Nič analitičnega se ne naloži, dokler obiskovalec ne izbere. Zapiranje brez izbire NE
 *    pomeni privolitve, zato pasica nima gumba X.
 * 3. Podrobnosti (kategorije, stikalo) so en klik stran pod "Settings", z istim besedilom kot prej.
 *
 * Izbira živi v localStorage pod `ndp_consent` (verzija 1), ne v piškotku, zato pred
 * privolitvijo na napravo ne zapišemo ničesar, kar bi bilo treba prijaviti.
 * qa-legal.mjs išče: dialog z imenom "cookies", gumba "Only necessary" in "Accept analytics".
 */
---

<div
  id="consent-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-title"
  aria-describedby="consent-text"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-surface shadow-bar"
>
  <div class="mx-auto max-w-content px-4 py-3 sm:py-3.5">
    <div class="md:flex md:items-center md:gap-6">
      <p id="consent-text" class="text-[0.8125rem] leading-snug text-muted md:flex-1">
        <strong id="consent-title" class="font-semibold text-ink">About cookies.</strong>
        We'd like to count visits with Google Analytics. Nothing loads unless you accept.
        <a href="/cookies" class="whitespace-nowrap underline underline-offset-2 hover:text-ink">Cookie policy</a>
        <span aria-hidden="true">/</span>
        <button
          type="button"
          id="consent-more"
          aria-expanded="false"
          aria-controls="consent-details"
          class="whitespace-nowrap underline underline-offset-2 hover:text-ink"
        >Settings</button>
      </p>

      <div class="mt-2.5 grid grid-cols-2 gap-2 md:mt-0 md:w-[22rem] md:shrink-0">
        <button
          type="button"
          id="consent-reject"
          class="min-h-11 rounded-full bg-ink px-3 text-sm font-semibold text-surface transition-[background-color,transform] duration-ui ease-out hover:bg-ink/85 active:scale-[0.97]"
        >Only necessary</button>
        <button
          type="button"
          id="consent-accept"
          class="min-h-11 rounded-full bg-ink px-3 text-sm font-semibold text-surface transition-[background-color,transform] duration-ui ease-out hover:bg-ink/85 active:scale-[0.97]"
        >Accept analytics</button>
      </div>
    </div>

    <div id="consent-details" hidden class="mt-3 border-t border-line pt-3">
      <div class="grid gap-2 sm:grid-cols-2">
        <div class="flex items-center justify-between gap-4 rounded-xl bg-canvas px-4 py-3">
          <div>
            <p class="text-sm font-medium text-ink">Strictly necessary</p>
            <p class="mt-0.5 text-xs text-muted">Only your answer to this question.</p>
          </div>
          <span class="shrink-0 text-xs text-muted">Always on</span>
        </div>
        <label class="flex cursor-pointer items-center justify-between gap-4 rounded-xl px-4 py-3 ring-1 ring-inset ring-line transition-colors duration-ui hover:bg-canvas">
          <span>
            <span class="block text-sm font-medium text-ink">Analytics</span>
            <span class="mt-0.5 block text-xs text-muted">Google Analytics, two cookies, two years.</span>
          </span>
          <input id="consent-analytics" type="checkbox" class="h-5 w-5 shrink-0 cursor-pointer rounded accent-[#9c5438]" />
        </label>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-muted">
          Change this any time from the footer.
          <a href="/privacy" class="underline underline-offset-2 hover:text-ink">Privacy policy</a>
        </p>
        <button
          type="button"
          id="consent-save"
          hidden
          class="min-h-11 rounded-full px-5 text-sm font-semibold text-ink ring-1 ring-inset ring-ink/25 transition-colors duration-ui hover:bg-canvas"
        >Save my choice</button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'ndp_consent';
    var VERSION = 1;
    var MAX_AGE = 180 * 24 * 60 * 60 * 1000; // 6 mesecev, potem vprašamo znova

    var banner = document.getElementById('consent-banner');
    var toggle = document.getElementById('consent-analytics');
    var saveBtn = document.getElementById('consent-save');
    var more = document.getElementById('consent-more');
    var details = document.getElementById('consent-details');

    function read() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var p = JSON.parse(raw);
        if (p.v !== VERSION) return null;
        if (Date.now() - new Date(p.at).getTime() > MAX_AGE) return null;
        return { analytics: p.analytics === true };
      } catch (e) {
        return null;
      }
    }

    function apply(state) {
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: state.analytics ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
      if (state.analytics) window.__ndpLoadAnalytics && window.__ndpLoadAnalytics();
    }

    function setDetails(open) {
      details.hidden = !open;
      more.setAttribute('aria-expanded', String(open));
    }

    function save(state) {
      try {
        localStorage.setItem(
          KEY,
          JSON.stringify({ analytics: state.analytics, at: new Date().toISOString(), v: VERSION })
        );
      } catch (e) {
        /* zasebno okno: izbira velja samo za to sejo */
      }
      banner.hidden = true;
      apply(state);
    }

    function open(withDetails) {
      var cur = read();
      toggle.checked = !!(cur && cur.analytics);
      saveBtn.hidden = true;
      setDetails(!!withDetails);
      banner.hidden = false;
    }

    // gumb "Cookie settings" v nogi odpre pasico takoj s podrobnostmi
    window.__ndpOpenConsent = function () { open(true); };

    var stored = read();
    if (stored) {
      apply(stored);
    } else {
      open(false);
    }

    more.addEventListener('click', function () {
      setDetails(details.hidden);
    });

    // "Save my choice" se pokaže šele, ko obiskovalec premakne stikalo
    toggle.addEventListener('change', function () {
      var cur = read();
      saveBtn.hidden = toggle.checked === !!(cur && cur.analytics);
    });

    document.getElementById('consent-reject').addEventListener('click', function () {
      save({ analytics: false });
    });
    document.getElementById('consent-accept').addEventListener('click', function () {
      save({ analytics: true });
    });
    saveBtn.addEventListener('click', function () {
      save({ analytics: toggle.checked });
    });

    // Escape zapre samo, če izbira že obstaja. Sicer bi bilo tiho zavračanje.
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !banner.hidden && read()) banner.hidden = true;
    });
  })();
</script>
