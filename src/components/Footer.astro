---
import { SITE } from '../site.config.mjs';
import { categories as getCategories } from '../lib/catalog.js';

const year = new Date().getFullYear();
const categories = getCategories();
---

<footer class="mt-20 border-t border-line bg-surface">
  <div class="mx-auto max-w-content px-4 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="font-serif text-xl font-bold text-ink">{SITE.name}</p>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
          {SITE.tagline} We comb through thousands of Amazon bestsellers so you only
          see the pieces worth your money.
        </p>
        <p class="mt-4 max-w-md text-xs leading-relaxed text-muted">
          <strong class="font-semibold text-ink">Affiliate disclosure:</strong> {SITE.disclosureShort}
          Prices and availability are accurate as of the date/time shown on Amazon and are
          subject to change. We earn a commission on qualifying purchases at no extra cost to you.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink">Shop</p>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          <li><a href="/shop" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">All finds</a></li>
          {categories.slice(0, 6).map((c) => (
            <li><a href={`/${c.slug}`} class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink">Explore</p>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          <li><a href="/" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Home</a></li>
          <li><a href="/blog" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Blog</a></li>
          <li><a href="/about" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">About</a></li>
          <li><a href="/disclosure" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Affiliate Disclosure</a></li>
          <li><a href="/privacy" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Privacy Policy</a></li>
          <li><a href="/cookies" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Cookie Policy</a></li>
          <li><a href="/terms" class="inline-flex min-h-9 items-center transition-colors duration-ui hover:text-ink">Terms of Use</a></li>
          <li>
            {/* preklic privolitve mora biti tako lahek kot privolitev sama */}
            <button
              type="button"
              onclick="window.__ndpOpenConsent && window.__ndpOpenConsent()"
              class="inline-flex min-h-11 items-center text-left transition-colors duration-ui hover:text-ink"
            >
              Cookie settings
            </button>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-10 border-t border-line pt-6 text-xs text-muted">
      © {year} {SITE.name}. As an Amazon Associate we earn from qualifying purchases.
      Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates.
    </p>
  </div>
</footer>
