---
/**
 * Kartica izdelka. Cela slika in ime peljeta na Amazon, gumb pove cilj ("Shop on Amazon").
 * Ocen ni: Associates §2(t) brez Creators/PA API ne dovoli prikaza Amazonovih ocen.
 *
 * variant="grid"  -> kompaktna (mreže, tirnice): slika 3:4, ime v 2 vrsticah, gumb
 * variant="wide"  -> blog "The finds": slika levo, opis, gumb
 */
import Icon from './Icon.astro';
import { displayName, photoFor, isNew } from '../lib/catalog.js';

const { product, eager = false, variant = 'grid' } = Astro.props;
// rel="nofollow sponsored" je OBVEZEN za affiliate povezave (Google + Amazon TOS)
const REL = 'nofollow sponsored noopener';
const name = displayName(product.title);
const photo = photoFor(product);
const scene = photo.kind === 'scene';
const fresh = isNew(product);
// Opis brez prvega stavka, če je ta trend statistika ("X is up 300% this month, and ...").
const sentences = (product.description || '').trim().split(/(?<=[.!?])\s+/);
if (sentences.length > 1 && /\bup \d[\d,]*\s?%/i.test(sentences[0])) sentences.shift();
const blurb = sentences.join(' ');
---

{variant === 'grid' ? (
  <article class="group flex flex-col">
    <a href={product.link} target="_blank" rel={REL} class="relative block overflow-hidden rounded-xl bg-surface ring-1 ring-line" tabindex="-1" aria-hidden="true">
      <img
        src={photo.src}
        alt=""
        width={photo.w}
        height={photo.h}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class:list={[
          'aspect-[3/4] w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]',
          scene ? 'object-cover' : 'object-contain p-3',
        ]}
      />
    </a>
    <div class="flex flex-1 flex-col pt-3">
      {/* Kategorije ugiba build_site_data iz naslova in so pogosto napačne, zato jih kartica ne kaže. */}
      {fresh && <p class="text-xs font-semibold text-terracotta">New</p>}
      <h3 class:list={['line-clamp-2 text-[0.95rem] font-semibold leading-snug text-ink sm:text-base', fresh && 'mt-1']}>
        <a href={product.link} target="_blank" rel={REL} title={product.title} class="hover:underline">{name}</a>
      </h3>
      <div class="mt-auto pt-3">
        <a href={product.link} target="_blank" rel={REL} class="btn-primary w-full whitespace-nowrap px-2 text-[0.8125rem]">
          Shop on Amazon
          <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </article>
) : (
  <article class="group grid grid-cols-[7.5rem_1fr] gap-4 rounded-xl bg-surface p-3 ring-1 ring-line sm:grid-cols-[10rem_1fr] sm:p-4">
    <a href={product.link} target="_blank" rel={REL} class="block overflow-hidden rounded-lg bg-surface" tabindex="-1" aria-hidden="true">
      <img
        src={photo.src}
        alt=""
        width={photo.w}
        height={photo.h}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class:list={['aspect-[3/4] w-full', scene ? 'object-cover' : 'object-contain p-2']}
      />
    </a>
    <div class="flex min-w-0 flex-col">
      <h3 class="text-base font-semibold leading-snug text-ink">
        <a href={product.link} target="_blank" rel={REL} title={product.title} class="hover:underline">{name}</a>
      </h3>
      {blurb && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{blurb}</p>}
      <a href={product.link} target="_blank" rel={REL} class="btn-primary mt-3 self-start">
        Shop on Amazon
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </article>
)}
